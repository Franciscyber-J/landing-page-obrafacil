RewriteRule ^ajuda/ja-jp(/.*)?$ /ja-jp/ヘルプ$1 [NC,R=301,L]
RewriteRule ^ajuda/hi-in(/.*)?$ /hi-in/सहायता$1 [NC,R=301,L]
RewriteRule ^ajuda/vi-vn(/.*)?$ /vi-vn/tro-giup$1 [NC,R=301,L]
RewriteRule ^ajuda/nl-nl(/.*)?$ /nl-nl/help$1 [NC,R=301,L]
RewriteRule ^ajuda/ko-kr(/.*)?$ /ko-kr/도움말$1 [NC,R=301,L]
RewriteRule ^ajuda/zh-tw(/.*)?$ /zh-tw/說明$1 [NC,R=301,L]
