# =============================================================================
# ObraFácil — appobrafacil.expertbr.com (Hostinger, pasta public_html/appobrafacil)
#
# Nesta pasta vivem duas coisas:
#   - o site (React, gerado pelo "npm run build": index.html + assets/)
#   - o WordPress, que não serve mais nada que o app use: Termos de Uso, Política de
#     Privacidade, Suporte, Perfil e as páginas de volta do pagamento passaram para o site
#     (páginas por idioma). Ver hospedagem/LEIAME.md (o que falta para desligá-lo).
#
# Este arquivo é versionado em landing_page/hospedagem/.htaccess. Para mudar,
# edite no repositório e copie o arquivo INTEIRO para a Hostinger.
# Os blocos "LSCACHE" e "WordPress" são escritos pelo plugin LiteSpeed Cache e
# pelo WordPress: se eles mudarem sozinhos no servidor, traga a mudança para cá.
# =============================================================================

DirectoryIndex index.html index.php
Options -Indexes

# -----------------------------------------------------------------------------
# Segurança: cabeçalhos em todas as respostas (site e WordPress)
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # index.html do site: sempre conferir se há versão nova (os arquivos de
    # assets/ têm o nome mudado a cada build, então podem ficar em cache).
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
        # Política de conteúdo do site em modo de TESTE (só avisa no console,
        # não bloqueia). Depois de conferido no navegador, troque
        # "Content-Security-Policy-Report-Only" por "Content-Security-Policy".
        Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://firestore.googleapis.com https://firebasestorage.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.doubleclick.net https://*.googleadservices.com https://*.google.com https://pagead2.googlesyndication.com; frame-src https://td.doubleclick.net https://bid.g.doubleclick.net https://www.googletagmanager.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# Segurança: WordPress
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# xmlrpc.php não é usado e permite testar centenas de senhas numa só requisição.
RewriteRule ^xmlrpc\.php$ - [F,L,NC]

# Arquivos que só servem para mostrar a versão ou que nunca devem ser abertos.
RewriteRule ^(readme\.html|license\.txt|wp-config\.php|wp-config-sample\.php|\.user\.ini|php\.ini|error_log)$ - [F,L,NC]
RewriteRule \.(bak|bk|old|orig|sql|log|swp)$ - [F,L,NC]

# Lista de usuários (entrega o nome de login do administrador) para quem não
# está logado: pela API e pelo ?author=N. É a primeira barreira; a definitiva é o
# arquivo wp-content/mu-plugins/obrafacil-seguranca.php (ver hospedagem/LEIAME.md).
RewriteCond %{HTTP_COOKIE} !wordpress_logged_in_ [NC]
RewriteRule ^wp-json/wp/v2/users - [F,L,NC]
RewriteCond %{HTTP_COOKIE} !wordpress_logged_in_ [NC]
RewriteCond %{QUERY_STRING} (^|&)rest_route=(/|%2F)?wp(/|%2F)v2(/|%2F)users [NC]
RewriteRule ^ - [F,L]
RewriteCond %{REQUEST_URI} !^/wp-admin/ [NC]
RewriteCond %{QUERY_STRING} (^|&)author=[0-9]+ [NC]
RewriteRule ^ - [F,L]

# Nenhum PHP roda dentro da pasta de uploads.
RewriteRule ^wp-content/uploads/.*\.(php|phtml|phar)$ - [F,L,NC]

# -----------------------------------------------------------------------------
# Termos de Uso e Política de Privacidade: os endereços antigos do WordPress
# (/termos-de-uso/ e /politicas-de-privacidade/) estão cadastrados na App Store e na
# Google Play. Eles continuam valendo e levam à página no idioma do navegador
# (primeiro idioma do cabeçalho Accept-Language; sem idioma conhecido, inglês).
# Mesma escolha de src/i18n/registro.js (campo regioes). Redirecionamento 302 e sem
# cache, porque o destino muda conforme quem abre.
# -----------------------------------------------------------------------------
RewriteRule ^(termos-de-uso|politicas-de-privacidade)/?$ - [E=LEGAL_IDIOMA:en-us,E=Cache-Control:no-cache]
RewriteCond %{HTTP:Accept-Language} ^pt\b [NC]
RewriteRule ^(termos-de-uso|politicas-de-privacidade)/?$ - [E=LEGAL_IDIOMA:pt-br]
RewriteCond %{HTTP:Accept-Language} ^pt-(PT|AO|MZ|CV|GW|ST|TL|MO)\b [NC]
RewriteRule ^(termos-de-uso|politicas-de-privacidade)/?$ - [E=LEGAL_IDIOMA:pt-pt]
RewriteCond %{HTTP:Accept-Language} ^es\b [NC]
RewriteRule ^(termos-de-uso|politicas-de-privacidade)/?$ - [E=LEGAL_IDIOMA:es-es]
RewriteCond %{HTTP:Accept-Language} ^es-(MX|419|AR|BO|CL|CO|CR|CU|DO|EC|GT|HN|NI|PA|PE|PR|PY|SV|US|UY|VE)\b [NC]
RewriteRule ^(termos-de-uso|politicas-de-privacidade)/?$ - [E=LEGAL_IDIOMA:es-mx]
RewriteCond %{HTTP:Accept-Language} ^en-(GB|IE|IN|ZA|SG|HK|NG|KE)\b [NC]
RewriteRule ^(termos-de-uso|politicas-de-privacidade)/?$ - [E=LEGAL_IDIOMA:en-gb]
RewriteCond %{HTTP:Accept-Language} ^en-(AU|NZ)\b [NC]
RewriteRule ^(termos-de-uso|politicas-de-privacidade)/?$ - [E=LEGAL_IDIOMA:en-au]
RewriteCond %{HTTP:Accept-Language} ^en-CA\b [NC]
RewriteRule ^(termos-de-uso|politicas-de-privacidade)/?$ - [E=LEGAL_IDIOMA:en-ca]
RewriteCond %{ENV:LEGAL_IDIOMA} ^pt-br$
RewriteRule ^termos-de-uso/?$ /pt-br/termos-de-uso [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^pt-br$
RewriteRule ^politicas-de-privacidade/?$ /pt-br/politica-de-privacidade [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^pt-pt$
RewriteRule ^termos-de-uso/?$ /pt-pt/termos-de-utilizacao [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^pt-pt$
RewriteRule ^politicas-de-privacidade/?$ /pt-pt/politica-de-privacidade [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^en-us$
RewriteRule ^termos-de-uso/?$ /en-us/terms-of-use [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^en-us$
RewriteRule ^politicas-de-privacidade/?$ /en-us/privacy-policy [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^en-gb$
RewriteRule ^termos-de-uso/?$ /en-gb/terms-of-use [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^en-gb$
RewriteRule ^politicas-de-privacidade/?$ /en-gb/privacy-policy [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^en-au$
RewriteRule ^termos-de-uso/?$ /en-au/terms-of-use [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^en-au$
RewriteRule ^politicas-de-privacidade/?$ /en-au/privacy-policy [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^en-ca$
RewriteRule ^termos-de-uso/?$ /en-ca/terms-of-use [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^en-ca$
RewriteRule ^politicas-de-privacidade/?$ /en-ca/privacy-policy [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^es-es$
RewriteRule ^termos-de-uso/?$ /es-es/terminos-de-uso [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^es-es$
RewriteRule ^politicas-de-privacidade/?$ /es-es/politica-de-privacidad [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^es-mx$
RewriteRule ^termos-de-uso/?$ /es-mx/terminos-de-uso [R=302,L]
RewriteCond %{ENV:LEGAL_IDIOMA} ^es-mx$
RewriteRule ^politicas-de-privacidade/?$ /es-mx/politica-de-privacidad [R=302,L]

# -----------------------------------------------------------------------------
# Páginas que o WordPress servia e que o app usa: volta do pagamento pelo navegador
# (Stripe), o link "Perfil" dos e-mails de cobrança e o Suporte. Os endereços estão nas
# sessões de pagamento da Stripe, num Payment Link e em e-mails já enviados: não podem
# mudar. Agora abrem o site (index.html, resposta 200), que leva à página no idioma da
# pessoa (src/i18n/idiomas.js, PAGINAS_ANTIGAS):
#   /primeiros-passos          PRO pago pelo site (e prêmio do Primeiros passos)
#   /pagamento-ok/             Acesso Cliente da obra
#   /pacote-downloads-extras/  pacote de downloads extras da galeria
#   /expansao-20gb-ok/         expansão de +20 GB
#   /perfil                    e-mails de pagamento não processado
#   /suporte/                  contato do suporte
# Ficam antes das regras do WordPress, que tem páginas com esses mesmos nomes.
# Com e sem barra no fim; o que vem depois do "?" é ignorado pelo site.
# -----------------------------------------------------------------------------
RewriteRule ^(pagamento-ok|pacote-downloads-extras|primeiros-passos|expansao-20gb-ok|perfil|suporte)/?$ /index.html [L,NC]

# -----------------------------------------------------------------------------
# Site (React): endereços do site abrem o index.html
# Endereços com prefixo de idioma (/pt-br/..., /en-us/..., /es-mx/...) e o antigo
# /ajuda. Qualquer idioma novo já entra pela regra (duas letras + região opcional).
# Arquivos que existem de verdade continuam sendo servidos direto, e também as pastas
# com index.html próprio (Termos e Política gerados no build: /pt-br/termos-de-uso/...).
# A pasta do idioma (/pt-br/) existe por causa dessas páginas, mas não tem index.html:
# sem a segunda condição abaixo ela dava 403 (Options -Indexes) em vez de abrir o site.
# -----------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^(ajuda(/.*)?|[a-z]{2}(-[a-z]{2})?(/.*)?)$ /index.html [L,NC]
</IfModule>

# BEGIN LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteRule litespeed/debug/.*\.log$ - [F,L]
RewriteRule \.litespeed_conf\.dat - [F,L]
</IfModule>
<IfModule LiteSpeed>
CacheLookup on
RewriteRule .* - [E=Cache-Control:no-autoflush]

### marker ASYNC start ###
RewriteCond %{REQUEST_URI} /wp-admin/admin-ajax\.php
RewriteCond %{QUERY_STRING} action=async_litespeed
RewriteRule .* - [E=noabort:1]
### marker ASYNC end ###

### marker DROPQS start ###
CacheKeyModify -qs:fbclid
CacheKeyModify -qs:gclid
CacheKeyModify -qs:utm*
CacheKeyModify -qs:_ga
### marker DROPQS end ###

</IfModule>
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END LSCACHE
# BEGIN NON_LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END NON_LSCACHE
# BEGIN WordPress
# As diretrizes (linhas) entre "BEGIN WordPress" e "END WordPress" são
# geradas dinamicamente e só devem ser modificadas através de filtros do WordPress.
# Quaisquer alterações nas diretivas entre esses marcadores serão sobrescritas.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
