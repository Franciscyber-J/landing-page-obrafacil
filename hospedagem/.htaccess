RewriteRule ^ajuda/uk-ua(/.*)?$ /uk-ua/довідка$1 [NC,R=301,L]
RewriteRule ^ajuda/ru-kz(/.*)?$ /ru-kz/справка$1 [NC,R=301,L]
RewriteRule ^ajuda/cs-cz(/.*)?$ /cs-cz/napoveda$1 [NC,R=301,L]
RewriteRule ^ajuda/el-gr(/.*)?$ /el-gr/βοήθεια$1 [NC,R=301,L]
RewriteRule ^ajuda/hu-hu(/.*)?$ /hu-hu/sugo$1 [NC,R=301,L]
RewriteRule ^ajuda/he-il(/.*)?$ /he-il/עזרה$1 [NC,R=301,L]
