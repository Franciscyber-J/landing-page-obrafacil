# =============================================================================
# ObraFácil — appobrafacil.expertbr.com (Hostinger, pasta public_html/appobrafacil)
#
# Nesta pasta fica só o site (React, gerado pelo "npm run build": o conteúdo de dist/). O WordPress foi
# desligado; as páginas que ele servia (Termos, Política, Suporte, Perfil, volta do pagamento) estão no
# site, em cada idioma, e os endereços antigos levam a elas (ver hospedagem/LEIAME.md).
#
# Este arquivo é versionado em landing_page/hospedagem/.htaccess. Para mudar, edite no repositório e
# copie o arquivo INTEIRO para a Hostinger. O bloco "ENDEREÇOS POR IDIOMA" (idiomas, endereços antigos, barra
# no fim, páginas prontas e o site) é gerado por "npm run htaccess" a partir de src/i18n/registro.js e de
# ferramentas/hospedagem/htaccess.mjs: mude lá e rode o comando (idioma novo: só rodar e enviar de novo).
# =============================================================================

DirectoryIndex index.html
Options -Indexes -MultiViews
# Sem a barra automática nas pastas: /pt-br/ajuda é a página pronta pt-br/ajuda.html, mesmo existindo a pasta
# pt-br/ajuda/ (a dos artigos). A página inicial do idioma (/pt-br → /pt-br/) tem regra própria, abaixo.
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>
AddDefaultCharset UTF-8

# -----------------------------------------------------------------------------
# Segurança e cache: cabeçalhos em todas as respostas
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # Redirecionamento que depende do idioma do navegador (raiz e endereços antigos): ninguém guarda.
    Header always merge Vary "Accept-Language" env=VARIA_IDIOMA
    Header always set Cache-Control "no-cache, private" env=VARIA_IDIOMA

    # Páginas do site (o index.html e as páginas prontas de cada idioma): sempre conferir se há versão nova
    # (os arquivos de assets/ têm o nome mudado a cada build, então podem ficar em cache).
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
        # Política de conteúdo do site em modo de TESTE (só avisa no console,
        # não bloqueia). Depois de conferido no navegador, troque
        # "Content-Security-Policy-Report-Only" por "Content-Security-Policy".
        Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://firestore.googleapis.com https://firebasestorage.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.doubleclick.net https://*.googleadservices.com https://*.google.com https://pagead2.googlesyndication.com; frame-src https://td.doubleclick.net https://bid.g.doubleclick.net https://www.googletagmanager.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    </FilesMatch>

    # robots.txt, sitemap.xml e llms.txt mudam a cada build: sem cache longo.
    <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Índice da Central de cada idioma (dados/ajuda/<idioma>.<código>.json): o nome muda quando o conteúdo
    # muda, então pode ficar guardado no navegador.
    <FilesMatch "\.[0-9a-f]{12}\.json$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# -----------------------------------------------------------------------------
# Arquivos que nunca devem ser abertos (backups, logs, configuração do PHP da hospedagem).
# -----------------------------------------------------------------------------
RewriteRule ^(\.user\.ini|php\.ini|error_log)$ - [F,L,NC]
RewriteRule \.(bak|bk|old|orig|sql|log|swp)$ - [F,L,NC]

# -----------------------------------------------------------------------------
# Um endereço só para cada página (o Google não vê cópias):
#   /index.html e /pt-br/index.html → / e /pt-br/
#   /pt-br/ajuda.html (arquivo da página pronta) → /pt-br/ajuda
# THE_REQUEST é o pedido original do navegador: as regras não pegam os redirecionamentos internos abaixo.
# -----------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+([a-z]{2}-[a-z]{2}/[^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# >>> ENDEREÇOS POR IDIOMA
# Gerado por "npm run htaccess" a partir de src/i18n/registro.js. Não edite à mão: rode o comando.
#
# 1) Idioma do navegador (Accept-Language), só nos endereços que precisam dele (a raiz e os antigos do
#    WordPress): a primeira língua da lista que o site tem; a região escolhe a variante. Mesma escolha de
#    src/i18n/idiomas.js (escolherIdioma).
RewriteRule ^(?:|termos\-de\-uso|politicas\-de\-privacidade|pagamento\-ok|pacote\-downloads\-extras|primeiros\-passos|expansao\-20gb\-ok|perfil|suporte|ajuda)/?$ - [NC,E=QUER_IDIOMA:1]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*pt-(?:br)(?![a-z0-9]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:pt-br]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*pt-(?:pt|ao|mz|cv|gw|st|tl|mo)(?![a-z0-9]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:pt-pt]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*en-(?:us)(?![a-z0-9]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:en-us]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*en-(?:gb|ie|in|za|sg|hk|ng|ke)(?![a-z0-9]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:en-gb]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*en-(?:au|nz)(?![a-z0-9]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:en-au]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*en-(?:ca)(?![a-z0-9]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:en-ca]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*es-(?:es)(?![a-z0-9]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:es-es]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*es-(?:mx|419|ar|bo|cl|co|cr|cu|do|ec|gt|hn|ni|pa|pe|pr|py|sv|us|uy|ve)(?![a-z0-9]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:es-mx]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*pt(?![a-z]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:pt-br]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*en(?![a-z]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:en-us]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:pt|en|es)(?![a-z]))[^,]*,)*\s*es(?![a-z]) [NC]
RewriteRule ^ - [E=IDIOMA_NAVEGADOR:es-es]

# 2) Raiz "/": vai para a página inicial no idioma da pessoa; sem língua conhecida, en-US (o mesmo
#    que o site faz). 302 de propósito: o destino muda conforme quem abre, e a raiz continua sendo a
#    "x-default" do hreflang (a porta de entrada que escolhe o idioma). Um 301 faria o Google e os
#    navegadores guardarem um idioma só para todo mundo.
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteRule ^$ /en-us/ [R=302,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^(pt-br|pt-pt|en-us|en-gb|en-au|en-ca|es-es|es-mx)$
RewriteRule ^$ /%1/ [R=302,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]

# 3) Endereços antigos do WordPress (estão nas lojas, na Stripe, num Payment Link, no app e em e-mails já
#    enviados): 301 para a mesma página no idioma do navegador. Sem cabeçalho de idioma nenhum (robôs, como o
#    Google), pt-BR: eram páginas em português, e o 301 passa o histórico delas para a página nova.
#    Com idioma, mas nenhum dos do site (de-DE, *...), en-US, como na raiz.
#    Sem cache (o destino muda conforme quem abre). Com e sem barra no fim, maiúsculas ou não.
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteCond %{HTTP:Accept-Language} ^\s*$
RewriteRule ^.+$ - [E=IDIOMA_NAVEGADOR:pt-br]
RewriteCond %{ENV:QUER_IDIOMA} =1
RewriteCond %{ENV:IDIOMA_NAVEGADOR} ^$
RewriteRule ^.+$ - [E=IDIOMA_NAVEGADOR:en-us]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-br
RewriteRule ^termos\-de\-uso/?$ /pt-br/termos-de-uso [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-br
RewriteRule ^politicas\-de\-privacidade/?$ /pt-br/politica-de-privacidade [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-br
RewriteRule ^pagamento\-ok/?$ /pt-br/pagamento-confirmado/acesso-cliente? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-br
RewriteRule ^pacote\-downloads\-extras/?$ /pt-br/pagamento-confirmado/downloads-extras? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-br
RewriteRule ^primeiros\-passos/?$ /pt-br/pagamento-confirmado/pro? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-br
RewriteRule ^expansao\-20gb\-ok/?$ /pt-br/pagamento-confirmado/mais-20-gb? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-br
RewriteRule ^perfil/?$ /pt-br/perfil? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-br
RewriteRule ^suporte/?$ /pt-br/suporte [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-br
RewriteRule ^ajuda/?$ /pt-br/ajuda [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-pt
RewriteRule ^termos\-de\-uso/?$ /pt-pt/termos-de-utilizacao [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-pt
RewriteRule ^politicas\-de\-privacidade/?$ /pt-pt/politica-de-privacidade [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-pt
RewriteRule ^pagamento\-ok/?$ /pt-pt/pagamento-confirmado/acesso-cliente? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-pt
RewriteRule ^pacote\-downloads\-extras/?$ /pt-pt/pagamento-confirmado/transferencias-extra? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-pt
RewriteRule ^primeiros\-passos/?$ /pt-pt/pagamento-confirmado/pro? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-pt
RewriteRule ^expansao\-20gb\-ok/?$ /pt-pt/pagamento-confirmado/mais-20-gb? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-pt
RewriteRule ^perfil/?$ /pt-pt/perfil? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-pt
RewriteRule ^suporte/?$ /pt-pt/apoio [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =pt-pt
RewriteRule ^ajuda/?$ /pt-pt/ajuda [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-us
RewriteRule ^termos\-de\-uso/?$ /en-us/terms-of-use [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-us
RewriteRule ^politicas\-de\-privacidade/?$ /en-us/privacy-policy [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-us
RewriteRule ^pagamento\-ok/?$ /en-us/payment-confirmed/client-access? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-us
RewriteRule ^pacote\-downloads\-extras/?$ /en-us/payment-confirmed/extra-downloads? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-us
RewriteRule ^primeiros\-passos/?$ /en-us/payment-confirmed/pro? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-us
RewriteRule ^expansao\-20gb\-ok/?$ /en-us/payment-confirmed/plus-20-gb? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-us
RewriteRule ^perfil/?$ /en-us/profile? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-us
RewriteRule ^suporte/?$ /en-us/support [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-us
RewriteRule ^ajuda/?$ /en-us/help [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-gb
RewriteRule ^termos\-de\-uso/?$ /en-gb/terms-of-use [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-gb
RewriteRule ^politicas\-de\-privacidade/?$ /en-gb/privacy-policy [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-gb
RewriteRule ^pagamento\-ok/?$ /en-gb/payment-confirmed/client-access? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-gb
RewriteRule ^pacote\-downloads\-extras/?$ /en-gb/payment-confirmed/extra-downloads? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-gb
RewriteRule ^primeiros\-passos/?$ /en-gb/payment-confirmed/pro? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-gb
RewriteRule ^expansao\-20gb\-ok/?$ /en-gb/payment-confirmed/plus-20-gb? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-gb
RewriteRule ^perfil/?$ /en-gb/profile? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-gb
RewriteRule ^suporte/?$ /en-gb/support [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-gb
RewriteRule ^ajuda/?$ /en-gb/help [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-au
RewriteRule ^termos\-de\-uso/?$ /en-au/terms-of-use [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-au
RewriteRule ^politicas\-de\-privacidade/?$ /en-au/privacy-policy [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-au
RewriteRule ^pagamento\-ok/?$ /en-au/payment-confirmed/client-access? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-au
RewriteRule ^pacote\-downloads\-extras/?$ /en-au/payment-confirmed/extra-downloads? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-au
RewriteRule ^primeiros\-passos/?$ /en-au/payment-confirmed/pro? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
