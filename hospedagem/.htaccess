RewriteRule ^politicas\-de\-privacidade/?$ /en-ca/privacy-policy [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-ca
RewriteRule ^pagamento\-ok/?$ /en-ca/payment-confirmed/client-access? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-ca
RewriteRule ^pacote\-downloads\-extras/?$ /en-ca/payment-confirmed/extra-downloads? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
