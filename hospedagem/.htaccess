# 4) Endereços antigos da Central com o idioma (/ajuda/pt-BR/criar-rdo) → /pt-br/ajuda/criar-rdo. Sem
#    idioma (/ajuda/criar-rdo), pt-BR. O site corrige sozinho o resto (nome do assunto no idioma).
RewriteRule ^ajuda/pt-br(/.*)?$ /pt-br/ajuda$1 [NC,R=301,L]
RewriteRule ^ajuda/pt-pt(/.*)?$ /pt-pt/ajuda$1 [NC,R=301,L]
RewriteRule ^ajuda/en-us(/.*)?$ /en-us/help$1 [NC,R=301,L]
RewriteRule ^ajuda/en-gb(/.*)?$ /en-gb/help$1 [NC,R=301,L]
