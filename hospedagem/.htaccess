RewriteCond %{ENV:IDIOMA_NAVEGADOR} =en-ca
RewriteRule ^ajuda/?$ /en-ca/help [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-es
RewriteRule ^termos\-de\-uso/?$ /es-es/terminos-de-uso [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-es
RewriteRule ^politicas\-de\-privacidade/?$ /es-es/politica-de-privacidad [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-es
RewriteRule ^pagamento\-ok/?$ /es-es/pago-confirmado/acceso-cliente? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-es
RewriteRule ^pacote\-downloads\-extras/?$ /es-es/pago-confirmado/descargas-extra? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-es
RewriteRule ^primeiros\-passos/?$ /es-es/pago-confirmado/pro? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-es
RewriteRule ^expansao\-20gb\-ok/?$ /es-es/pago-confirmado/mas-20-gb? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-es
RewriteRule ^perfil/?$ /es-es/perfil? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-es
RewriteRule ^suporte/?$ /es-es/soporte [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-es
RewriteRule ^ajuda/?$ /es-es/ayuda [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-mx
RewriteRule ^termos\-de\-uso/?$ /es-mx/terminos-de-uso [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-mx
RewriteRule ^politicas\-de\-privacidade/?$ /es-mx/politica-de-privacidad [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-mx
RewriteRule ^pagamento\-ok/?$ /es-mx/pago-confirmado/acceso-cliente? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-mx
RewriteRule ^pacote\-downloads\-extras/?$ /es-mx/pago-confirmado/descargas-extra? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-mx
RewriteRule ^primeiros\-passos/?$ /es-mx/pago-confirmado/pro? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-mx
RewriteRule ^expansao\-20gb\-ok/?$ /es-mx/pago-confirmado/mas-20-gb? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-mx
RewriteRule ^perfil/?$ /es-mx/perfil? [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-mx
RewriteRule ^suporte/?$ /es-mx/soporte [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]
RewriteCond %{ENV:IDIOMA_NAVEGADOR} =es-mx
RewriteRule ^ajuda/?$ /es-mx/ayuda [NC,R=301,L,E=VARIA_IDIOMA:1,E=Cache-Control:no-cache]

# 4) Endereços antigos da Central com o idioma (/ajuda/pt-BR/criar-rdo) → /pt-br/ajuda/criar-rdo. Sem
#    idioma (/ajuda/criar-rdo), pt-BR. O site corrige sozinho o resto (nome do assunto no idioma).
RewriteRule ^ajuda/pt-br(/.*)?$ /pt-br/ajuda$1 [NC,R=301,L]
RewriteRule ^ajuda/pt-pt(/.*)?$ /pt-pt/ajuda$1 [NC,R=301,L]
RewriteRule ^ajuda/en-us(/.*)?$ /en-us/help$1 [NC,R=301,L]
RewriteRule ^ajuda/en-gb(/.*)?$ /en-gb/help$1 [NC,R=301,L]
RewriteRule ^ajuda/en-au(/.*)?$ /en-au/help$1 [NC,R=301,L]
RewriteRule ^ajuda/en-ca(/.*)?$ /en-ca/help$1 [NC,R=301,L]
RewriteRule ^ajuda/es-es(/.*)?$ /es-es/ayuda$1 [NC,R=301,L]
RewriteRule ^ajuda/es-mx(/.*)?$ /es-mx/ayuda$1 [NC,R=301,L]
RewriteRule ^ajuda/(.+)$ /pt-br/ajuda/$1 [NC,R=301,L]

# 5) Idioma com maiúsculas (/PT-BR/ajuda) → minúsculas; página inicial sem barra (/pt-br) → com barra.
RewriteCond %{REQUEST_URI} !^/pt-br(?:/|$)
RewriteRule ^pt-br(/.*)?$ /pt-br$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/pt-pt(?:/|$)
RewriteRule ^pt-pt(/.*)?$ /pt-pt$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/en-us(?:/|$)
RewriteRule ^en-us(/.*)?$ /en-us$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/en-gb(?:/|$)
RewriteRule ^en-gb(/.*)?$ /en-gb$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/en-au(?:/|$)
RewriteRule ^en-au(/.*)?$ /en-au$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/en-ca(?:/|$)
RewriteRule ^en-ca(/.*)?$ /en-ca$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/es-es(?:/|$)
RewriteRule ^es-es(/.*)?$ /es-es$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/es-mx(?:/|$)
RewriteRule ^es-mx(/.*)?$ /es-mx$1 [NC,R=301,L]
RewriteRule ^(pt-br|pt-pt|en-us|en-gb|en-au|en-ca|es-es|es-mx)$ /$1/ [R=301,L]

# 6) Barra no fim: só a página inicial do idioma tem (/pt-br/). /pt-br/ajuda/ → /pt-br/ajuda (301).
RewriteRule ^([a-z]{2}-[a-z]{2}/.+)/$ /$1 [R=301,L]

# 7) Páginas prontas do build (texto já no HTML, para o Google e os buscadores com IA): /pt-br/ajuda/criar-rdo
#    é entregue a partir de pt-br/ajuda/criar-rdo.html, sem mudar o endereço. Quando o endereço é uma pasta
#    (/pt-br/ajuda é também a pasta dos artigos), o servidor pode pôr uma barra no fim do nome do arquivo
#    pedido: a primeira condição tira essa barra.
RewriteCond %{REQUEST_FILENAME} ^(.*?)/?$
RewriteCond %1.html -f
RewriteRule ^([a-z]{2}-[a-z]{2}/.+)$ /$1.html [L]

# 8) Os outros endereços do site abrem o index.html e o site desenha a página no navegador (artigo publicado
#    depois do último build, endereço com o nome antigo de um artigo...). Arquivos de verdade são servidos
#    direto. Pasta com index.html só quando pedida com a barra (/pt-br/ → pt-br/index.html); pedida sem a
#    barra (pasta velha de um build antigo, com a barra automática desligada), abre o site, sem 404 nem vaivém.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$ [OR]
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^(ajuda(/.*)?|[a-z]{2}(-[a-z]{2})?(/.*)?)$ /index.html [L,NC]
# <<< ENDEREÇOS POR IDIOMA
</IfModule>
