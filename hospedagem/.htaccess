# 5) Idioma com maiúsculas (/PT-BR/ajuda) → minúsculas; página inicial sem barra (/pt-br) → com barra.
RewriteCond %{REQUEST_URI} !^/pt-br(?:/|$)
RewriteRule ^pt-br(/.*)?$ /pt-br$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/pt-pt(?:/|$)
RewriteRule ^pt-pt(/.*)?$ /pt-pt$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/en-us(?:/|$)
RewriteRule ^en-us(/.*)?$ /en-us$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/en-gb(?:/|$)
RewriteRule ^en-gb(/.*)?$ /en-gb$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/en-au(?:/|$)
RewriteRule ^en-au(/.*)?$ /en-au$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/en-ca(?:/|$)
RewriteRule ^en-ca(/.*)?$ /en-ca$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/es-es(?:/|$)
RewriteRule ^es-es(/.*)?$ /es-es$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/es-mx(?:/|$)
RewriteRule ^es-mx(/.*)?$ /es-mx$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/fr-fr(?:/|$)
RewriteRule ^fr-fr(/.*)?$ /fr-fr$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/de-de(?:/|$)
RewriteRule ^de-de(/.*)?$ /de-de$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/ar-sa(?:/|$)
RewriteRule ^ar-sa(/.*)?$ /ar-sa$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/it-it(?:/|$)
RewriteRule ^it-it(/.*)?$ /it-it$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/tr-tr(?:/|$)
RewriteRule ^tr-tr(/.*)?$ /tr-tr$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/pl-pl(?:/|$)
RewriteRule ^pl-pl(/.*)?$ /pl-pl$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/id-id(?:/|$)
RewriteRule ^id-id(/.*)?$ /id-id$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/ja-jp(?:/|$)
RewriteRule ^ja-jp(/.*)?$ /ja-jp$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/hi-in(?:/|$)
RewriteRule ^hi-in(/.*)?$ /hi-in$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/vi-vn(?:/|$)
RewriteRule ^vi-vn(/.*)?$ /vi-vn$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/nl-nl(?:/|$)
RewriteRule ^nl-nl(/.*)?$ /nl-nl$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/ko-kr(?:/|$)
RewriteRule ^ko-kr(/.*)?$ /ko-kr$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/zh-tw(?:/|$)
RewriteRule ^zh-tw(/.*)?$ /zh-tw$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/ro-ro(?:/|$)
RewriteRule ^ro-ro(/.*)?$ /ro-ro$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/th-th(?:/|$)
RewriteRule ^th-th(/.*)?$ /th-th$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/uk-ua(?:/|$)
RewriteRule ^uk-ua(/.*)?$ /uk-ua$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/ru-kz(?:/|$)
RewriteRule ^ru-kz(/.*)?$ /ru-kz$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/cs-cz(?:/|$)
RewriteRule ^cs-cz(/.*)?$ /cs-cz$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/el-gr(?:/|$)
RewriteRule ^el-gr(/.*)?$ /el-gr$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/hu-hu(?:/|$)
RewriteRule ^hu-hu(/.*)?$ /hu-hu$1 [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/he-il(?:/|$)
RewriteRule ^he-il(/.*)?$ /he-il$1 [NC,R=301,L]
RewriteRule ^(pt-br|pt-pt|en-us|en-gb|en-au|en-ca|es-es|es-mx|fr-fr|de-de|ar-sa|it-it|tr-tr|pl-pl|id-id|ja-jp|hi-in|vi-vn|nl-nl|ko-kr|zh-tw|ro-ro|th-th|uk-ua|ru-kz|cs-cz|el-gr|hu-hu|he-il)$ /$1/ [R=301,L]

# 6) Barra no fim: só a página inicial do idioma tem (/pt-br/). /pt-br/ajuda/ → /pt-br/ajuda (301).
RewriteRule ^([a-z]{2}-[a-z]{2}/.+)/$ /$1 [R=301,L]

# 7) Páginas prontas do build (texto já no HTML, para o Google e os buscadores com IA): /pt-br/ajuda/criar-rdo
#    é entregue a partir de pt-br/ajuda/criar-rdo.html, sem mudar o endereço. Quando o endereço é uma pasta
#    (/pt-br/ajuda é também a pasta dos artigos), o servidor pode pôr uma barra no fim do nome do arquivo
#    pedido: a primeira condição tira essa barra.
RewriteCond %{REQUEST_FILENAME} ^(.*?)/?$
RewriteCond %1.html -f
RewriteRule ^([a-z]{2}-[a-z]{2}/.+)$ /$1.html [L]

# 8) Os outros endereços do site abrem o index.html e o site desenha a página no navegador (artigo publicado
#    depois do último build, endereço com o nome antigo de um artigo...). Arquivos de verdade são servidos
#    direto. Pasta com index.html só quando pedida com a barra (/pt-br/ → pt-br/index.html); pedida sem a
#    barra (pasta velha de um build antigo, com a barra automática desligada), abre o site, sem 404 nem vaivém.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$ [OR]
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^(ajuda(/.*)?|[a-z]{2}(-[a-z]{2})?(/.*)?)$ /index.html [L,NC]
# <<< ENDEREÇOS POR IDIOMA
</IfModule>
