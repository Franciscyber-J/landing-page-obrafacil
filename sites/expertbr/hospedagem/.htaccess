# <<< IDIOMAS DA EXPERTBR

# -----------------------------------------------------------------------------
# 4) Um endereço só para cada página: /index.html → /. (THE_REQUEST é o pedido original do navegador.)
# -----------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 3e) Outras páginas do WordPress (terminadas em "/"), depois das regras dos idiomas.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^[^./][^/]*(?:/[^/]+)*/$ https://appobrafacil.expertbr.com/ [R=301,L]
